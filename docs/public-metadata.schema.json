{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandovaldavid/kioku/docs/public-metadata.schema.json",
  "title": "Kioku public metadata",
  "type": "object",
  "required": ["schemaVersion", "server", "transports", "capabilities", "environmentVariables", "versioning"],
  "properties": {
    "schemaVersion": {"const": 1},
    "server": {"type": "object"},
    "transports": {"type": "array", "minItems": 2},
    "capabilities": {"type": "object"},
    "environmentVariables": {"type": "array", "minItems": 1},
    "versioning": {"type": "object"}
  },
  "additionalProperties": false
}
