<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xUnit owns the lifetime of test classes and recognizes IAsyncLifetime/IDisposable
         cleanup patterns that the general-purpose ownership analyzers cannot infer. Constant
         arrays in tests optimize readability and isolation rather than hot-path allocations.
         Keep these diagnostics visible without blocking production-quality analyzer gates. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1001;CA1816;CA1861</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kioku.Mcp.Server\Kioku.Mcp.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.bib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\golden-set.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\BridgeProtocol\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Coordination\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
