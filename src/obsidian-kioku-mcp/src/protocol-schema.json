{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kioku Bridge Protocol",
  "description": "Shared wire format between the Obsidian plugin bridge and the Kioku MCP server.",
  "definitions": {
    "BridgeMessage": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string" },
        "payload": { "type": "object" },
        "requestId": { "type": "string" },
        "protocolVersion": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "BridgeResponse": {
      "type": "object",
      "required": ["success"],
      "properties": {
        "requestId": { "type": "string" },
        "success": { "type": "boolean" },
        "data": {},
        "error": { "type": "string" },
        "protocolVersion": { "type": "integer" }
      },
      "additionalProperties": false
    }
  }
}
