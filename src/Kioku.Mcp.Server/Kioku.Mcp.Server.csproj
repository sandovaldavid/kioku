<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- API-only server: no wwwroot/Razor content, so static web assets add nothing but
         RID-path complications for `dotnet pack`. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

    <!-- Self-Contained: binario portable, no requiere .NET instalado.
         Scoped to an explicit runtime publish only (matches the release workflow's
         self-contained, per-RID "dotnet publish" calls); unscoped, these forced
         "dotnet pack" (a framework-dependent PackAsTool package) to try bundling all 4
         RuntimeIdentifiers even though only the current platform had been built. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</PublishSelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>

    <!-- Metadatos del paquete Kioku -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kioku</ToolCommandName>
    <PackageType>McpServer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>kioku-mcp-server</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>AI; MCP; obsidian; notes; server; stdio; http-sse</PackageTags>
    <Description>Kioku — MCP server for Obsidian vault access. Enables AI agents to search, read and write notes via the Model Context Protocol.</Description>
    <Authors>sandovaldavid</Authors>
    <Copyright>Copyright © 2026 sandovaldavid</Copyright>

    <!-- Análisis de trimming para preparar v3 (Native AOT) -->
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>
  </PropertyGroup>

  <ItemGroup>
    <None Include=".mcp\server.json" Pack="true" PackagePath="/.mcp/"/>
    <None Include="README.md" Pack="true" PackagePath="/"/>
  </ItemGroup>

  <ItemGroup>
    <!-- SDK MCP oficial de Microsoft -->
    <!-- v1: stdio transport -->
    <PackageReference Include="Markdig" Version="0.38.0"/>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0"/>
    <!-- v2: HTTP-SSE transport (Streamable HTTP) -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0"/>
    <PackageReference Include="Sentry.AspNetCore" Version="5.6.0"/>
    <PackageReference Include="YamlDotNet" Version="18.0.0"/>
  </ItemGroup>

</Project>
