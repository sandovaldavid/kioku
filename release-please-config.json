{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        {
          "type": "xml",
          "path": "src/Kioku.Mcp.Server/Kioku.Mcp.Server.csproj",
          "xpath": "//PackageVersion"
        },
        {
          "type": "json",
          "path": "src/obsidian-kioku-mcp/manifest.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src/obsidian-kioku-mcp/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
