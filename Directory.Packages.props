<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.404" />
    <PackageVersion Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageVersion Include="NJsonSchema" Version="11.6.2" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
