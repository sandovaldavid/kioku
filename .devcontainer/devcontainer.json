{
  "name": "kioku",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "DOTNET_VARIANT": "10.0-noble"
    }
  },
  "runArgs": [
    "--security-opt",
    "label=disable"
  ],
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
      "upgradePackages": false,
      "username": "vscode"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {},
    "ghcr.io/devcontainers-extra/features/starship:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "timonwong.shellcheck"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font', 'Cascadia Code', monospace",
        "terminal.integrated.shellIntegration.enabled": true,
        "remote.restoreForwardedPorts": true,
        "eslint.workingDirectories": [
          {
            "mode": "auto"
          }
        ],
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        }
      }
    }
  },
  "containerEnv": {
    "DEVCONTAINER": "true",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip",
    "KIOKU_HTTP_PORT": "5173",
    "ZDOTDIR": "${containerWorkspaceFolder}/.devcontainer/config"
  },
  "init": true,
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Kioku Streamable HTTP",
      "protocol": "http",
      "onAutoForward": "notify",
      "requireLocalPort": true
    }
  },
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "shutdownAction": "stopContainer"
}
